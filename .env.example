# Fully Resourced — environment variables
# Copy to .env and fill in. Do NOT commit real values.
# VITE_* values are bundled into the client and are PUBLIC by design.
# Everything without the VITE_ prefix is server-only.

# ── Payments (built-in Stripe integration) ──────────────────────────────────
# All of these are provisioned automatically — no manual values needed.
# Gateway connection identifiers (NOT Stripe secret keys):
#   STRIPE_SANDBOX_API_KEY, STRIPE_LIVE_API_KEY
# Webhook signing secrets:
#   PAYMENTS_SANDBOX_WEBHOOK_SECRET, PAYMENTS_LIVE_WEBHOOK_SECRET
# Gateway auth: LOVABLE_API_KEY
#
# Client token (public, bundled). pk_test_… in .env.development,
# pk_live_… in .env.production. Test vs live is derived from its prefix.
VITE_PAYMENTS_CLIENT_TOKEN=

# ── Supabase (server-only secret) ───────────────────────────────────────────
# SECRET. Service-role key used by the webhook and server functions. Never expose.
SUPABASE_SERVICE_ROLE_KEY=
# Project URL for server code.
SUPABASE_URL=

# ── Supabase (client, public) ───────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
