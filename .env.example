# Fully Resourced — environment variables
# Copy to .env and fill in. Do NOT commit real values.
# VITE_* values are bundled into the client and are PUBLIC by design.
# Everything without the VITE_ prefix is server-only.

# ── Stripe (server-only secrets) ────────────────────────────────────────────
# SECRET. Test/sandbox secret key (sk_test_… now; sk_live_… at go-live).
STRIPE_SECRET_KEY=
# SECRET. Webhook signing secret used to verify Stripe webhook signatures (whsec_…).
STRIPE_WEBHOOK_SECRET=

# ── Stripe (server-side config, not secret) ─────────────────────────────────
# Stripe Price IDs the server maps plan selections to (price_…).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Founding-member coupon ID, applied server-side. Leave blank to disable.
STRIPE_FOUNDING_COUPON=

# ── Stripe (client, public) ─────────────────────────────────────────────────
# Publishable key (pk_test_… / pk_live_…). Public — safe in the client bundle.
# The app determines sandbox vs live from this key's prefix.
VITE_STRIPE_PUBLISHABLE_KEY=

# ── Supabase (server-only secret) ───────────────────────────────────────────
# SECRET. Service-role key used by the webhook and server functions. Never expose.
SUPABASE_SERVICE_ROLE_KEY=
# Project URL for server code.
SUPABASE_URL=

# ── Supabase (client, public) ───────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Optional: separate live Stripe keys (legacy dual-environment support) ────
# Only needed if you run sandbox and live from the same deployment. In a normal
# production deploy, put the live values in STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET.
# STRIPE_LIVE_SECRET_KEY=
# STRIPE_LIVE_WEBHOOK_SECRET=
